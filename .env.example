# =============================================================================
# N8FLOW — .env.example
# Arquivo de referência das variáveis de ambiente necessárias.
# NUNCA coloque valores reais neste arquivo.
# Crie um .env.local para desenvolvimento e configure variáveis no dashboard da Vercel.
# =============================================================================

# ---------------------------------------------------------------------------
# URL pública do site (obrigatória em produção)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Analytics (IDs pendentes de definição — não inventar)
# ---------------------------------------------------------------------------
# Google Tag Manager Container ID (ex.: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (ex.: G-XXXXXXXXXX)
# Nota: prefer GTM quando ambos forem usados
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID (ex.: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Captação Supabase — server-side APENAS
# Nunca usar prefixo NEXT_PUBLIC_ para segredos
# ---------------------------------------------------------------------------
LEAD_CAPTURE_ENABLED=false

# --- Desenvolvimento local (Docker + Supabase CLI) ---
# Execute `npm run db:start` para subir o banco local.
# Os valores abaixo são impressos por `npm run db:status` após o start.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SECRET_KEY=<service_role key impressa por db:status>
# LEAD_RATE_LIMIT_SECRET=<segredo aleatório de 32+ caracteres>
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Produção (projeto Supabase remoto, configurado na Vercel) ---
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...  ← secret key, nunca publishable key
# LEAD_RATE_LIMIT_SECRET=<segredo aleatório de 32+ caracteres, diferente do de dev>
# NEXT_PUBLIC_SITE_URL=https://n8flow.com.br

# Ative LEAD_CAPTURE_ENABLED=true somente após migração e QA em sandbox.
# Sem configuração a rota retorna 503 sem mock nem fallback.

# ---------------------------------------------------------------------------
# Gateway de pagamento — PENDENTE (fornecedor não definido)
# Descomente e renomeie quando o fornecedor for escolhido via ADR-0002
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Error tracking — PENDENTE (Sentry recomendado antes do go-live)
# Descomente quando configurado via ADR-0003
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Ambiente (definido automaticamente pela Vercel)
# ---------------------------------------------------------------------------
# VERCEL_ENV=development|preview|production
